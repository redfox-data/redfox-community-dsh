{
  "name": "redfox-community-dsh",
  "version": "0.1.0",
  "description": "RedFox community skills for DeepSeek Harness: 100+ social-media data skills (Douyin, Xiaohongshu, Kuaishou, Bilibili, WeChat, Weibo, YouTube, TikTok and more), mirrored one-way from the redfox-community hub repo.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redfox-data/redfox-community-dsh.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "plugin",
    "skill",
    "redfox",
    "douyin",
    "xiaohongshu",
    "kuaishou",
    "bilibili",
    "wechat",
    "weibo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "marketplace": {
      "profiles": [
        "web",
        "headless"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  }
}
